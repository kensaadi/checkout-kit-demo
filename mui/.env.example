# API host of the BE. In dev points to the Go server.
VITE_APP_API_HOST=http://localhost:3333

# Stripe publishable key. test-mode (pk_test_*) in dev/staging,
# live (pk_live_*) only in production.
VITE_STRIPE_PK=pk_test_replace_me

# 'live' calls the BE over HTTP. 'mock' uses the in-memory
# providers under api/*/mock/. Switch to 'mock' for offline demo
# or when the BE is not running.
VITE_PROVIDER=mock
